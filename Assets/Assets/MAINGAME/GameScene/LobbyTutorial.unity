  playOpeningSequenceBeforeDay1: 1
  introSteps:
  - roleName: Host
    message: The Host greets arriving customers and assigns them to the correct table.
    cameraAnchor: {fileID: 3248032659727736724}
    highlightTarget: {fileID: 5484305702487525111}
  - roleName: Waiter
    message: The Waiter takes orders, delivers food, gives the bill, and collects
      payment from customers.
    cameraAnchor: {fileID: 1566338811448752606}
    highlightTarget: {fileID: 3371572443688536932}
  - roleName: Cashier
    message: The Cashier processes orders and handles customer payments accurately.
    cameraAnchor: {fileID: 7765254894572102197}
    highlightTarget: {fileID: 567677548718045326}
  - roleName: Busser
    message: The Busser cleans finished trays and resets tables for the next customers.
    cameraAnchor: {fileID: 7075473984031470788}
    highlightTarget: {fileID: 5371330271326737775}
  returnCameraAfterIntro: 1
  gameplayCameraAnchorAfterIntro: {fileID: 1683000274}
  openingDoneMessage: "Now that you know the roles, let\u2019s begin with the Host.
    Greet the first customer."
